# Copy to .env.local. Never commit credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=dinethlaksitha@gmail.com
# Gmail app password, without spaces. Save the real value only in .env.local.
SMTP_PASSWORD=
# For Gmail, use the authenticated account as the sender.
MAIL_FROM="Dineth Madhuranga <dinethlaksitha@gmail.com>"
CONTACT_TO_EMAIL=dinethlaksitha@gmail.com

# Set to your final HTTPS origin before deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Use a long random value; hashes IP addresses and submission payloads.
CONTACT_HASH_SECRET=
# Local development only. Sends email using the configured SMTP account. Ignored in production.
CONTACT_TEST_MODE=false
